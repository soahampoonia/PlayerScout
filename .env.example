# Copy to .env to override a default. Everything here is optional.

# Ports on your machine
WEB_PORT=5173
API_PORT=8000

# Database (used by both the db container and Django)
POSTGRES_DB=playerscout
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout

# Django
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO

# NBA ingestion
# Leave empty to derive the season from today's date ("2026-27" from October on).
NBA_SEASON=
# Seasons of game logs to keep: the current one plus N-1 before it.
NBA_LOG_SEASONS=2
# Optional HTTP proxy for stats.nba.com, e.g. http://user:pass@host:port
# Only needed if the NBA blocks your IP (it blocks most cloud and VPN ranges).
NBA_PROXY=

# Polymarket (public data; no key needed)
# Markets with a bid/ask spread wider than this, or less than this many dollars
# traded in 24 hours, are shown greyed out as "thin".
MARKET_THIN_SPREAD=0.05
MARKET_THIN_MIN_VOLUME_24H=100
# Seconds between price snapshots when a price is not moving.
MARKET_SNAPSHOT_HEARTBEAT=600

# LLM analysis (OpenAI Responses API with Structured Outputs)
# Your key from platform.openai.com. Without it the Analyze button says so.
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
# none, low, medium, high, xhigh or max: more effort is slower and costs more.
LLM_REASONING_EFFORT=medium
# LLM_PROVIDER=fake gives canned answers with no key and no cost (for trying the app).
LLM_PROVIDER=openai
